# Paramify API. The key is required; the URL defaults to production.
PARAMIFY_API_KEY=
# PARAMIFY_URL=https://app.paramify.com/api/v0
# Staging, if you have a staging tenant and a staging token:
# PARAMIFY_URL=https://stage.paramify.com/api/v0

# Default program when --program-id is omitted.
# PROGRAM_ID=

# NVD API key — optional but strongly recommended. Without one NVD allows only
# 5 requests / 30s (vs 50 with a key), and the client paces itself to match: a
# few thousand CVEs takes minutes unkeyed versus seconds keyed.
# Request one free at https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=
# CVEs per request. NVD's `cveIds` parameter batches; 100 is comfortable.
# NVD_BATCH_SIZE=100

# --- set-original-levels ---------------------------------------------------

# Directory of scanner CSV exports, searched recursively. These supply the
# scanner's own CVSS and severity columns, which are rungs 2 and 3 of the
# fallback ladder and appear nowhere in the Paramify API. Without this the
# ladder is NVD-only.
# SCAN_DIR=

# The assessment to adjust, by name or id. Required (here or via --assessment).
# Resolved to its mechanism element, which is what an issue carries as
# `origin.name` — an issue has no assessment id, so that name is the only link
# the API offers back to an assessment.
# ASSESSMENT=

# Never lower an existing originalLevel. Off by default — the ladder is
# authoritative in both directions — but a run that would downgrade findings on
# a live POA&M is worth a human's eye first.
# ONLY_RAISE=false
